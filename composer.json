{
    "name": "supabasephp/supabase",
    "description": "A modular, secure, and developer-friendly Supabase SDK for PHP.",
    "type": "project",
    "license": "MIT",

    "require": {
        "php": "^8.4",

        "supabasephp/core": "self.version",
        "supabasephp/http": "self.version",
        "supabasephp/auth": "self.version",
        "supabasephp/database": "self.version",
        "supabasephp/storage": "self.version",
        "supabasephp/realtime": "self.version",
        "supabasephp/functions": "self.version",
        "supabasephp/vector": "self.version",
        "supabasephp/client": "self.version"
    },

    "require-dev": {
        "phpunit/phpunit": "^12.0",

        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",

        "laravel/pint": "^1.0",
        "rector/rector": "^2.0",
        "fakerphp/faker": "^1.24"
    },

    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true
            }
        }
    ],

    "autoload-dev": {
        "psr-4": {
            "Supabase\\Tests\\": "tests/"
        }
    },

    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "test:integration": "phpunit --testsuite Integration",

        "analyse": "phpstan analyse --configuration=phpstan.neon",

        "format": "pint",
        "format:test": "pint --test",

        "refactor": "rector process",

        "quality": [
            "@format:test",
            "@analyse",
            "@test"
        ]
    },

    "config": {
        "platform": {
            "php": "8.4.1"
        },
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "allow-plugins": {}
    },

    "minimum-stability": "dev",
    "prefer-stable": true
}
