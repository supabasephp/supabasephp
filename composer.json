{
    "name": "supabasephp/monorepo",
    "description": "Monorepo for the modular Supabase PHP SDK.",
    "type": "project",
    "license": "MIT",
    "private": true,

    "require": {
        "php": "^8.4",
        "supabasephp/core": "1.0.x-dev",
        "supabasephp/http": "1.0.x-dev",
        "supabasephp/auth": "1.0.x-dev",
        "supabasephp/database": "1.0.x-dev",
        "supabasephp/storage": "1.0.x-dev",
        "supabasephp/realtime": "1.0.x-dev",
        "supabasephp/functions": "1.0.x-dev",
        "supabasephp/vector": "1.0.x-dev",
        "supabasephp/client": "1.0.x-dev"
    },

    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "laravel/pint": "^1.0",
        "rector/rector": "^2.0",
        "fakerphp/faker": "^1.24"
    },

    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "supabasephp/core": "1.0.x-dev",
                    "supabasephp/http": "1.0.x-dev",
                    "supabasephp/auth": "1.0.x-dev",
                    "supabasephp/database": "1.0.x-dev",
                    "supabasephp/storage": "1.0.x-dev",
                    "supabasephp/realtime": "1.0.x-dev",
                    "supabasephp/functions": "1.0.x-dev",
                    "supabasephp/vector": "1.0.x-dev",
                    "supabasephp/client": "1.0.x-dev"
                }
            }
        }
    ],

    "autoload-dev": {
        "psr-4": {
            "Supabase\\Tests\\": "tests/"
        }
    },

    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "test:integration": "phpunit --testsuite Integration",
        "analyse": "phpstan analyse --configuration=phpstan.neon",
        "format": "pint",
        "format:test": "pint --test",
        "refactor": "rector process",
        "quality": [
            "@format:test",
            "@analyse",
            "@test"
        ]
    },

    "config": {
        "platform": {
            "php": "8.4.0"
        },
        "sort-packages": true,
        "optimize-autoloader": true,
        "preferred-install": {
            "*": "dist"
        },
        "allow-plugins": {}
    },

    "minimum-stability": "dev",
    "prefer-stable": true
}
