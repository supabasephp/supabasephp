{
    "name": "supabasephp/client",
    "description": "A modern, modular and strongly typed Supabase SDK for PHP.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "supabase",
        "supabase-php",
        "php",
        "sdk",
        "database",
        "authentication",
        "storage",
        "realtime",
        "postgrest",
        "api"
    ],

    "homepage": "https://github.com/YOUR_USERNAME/supabasephp",

    "support": {
        "issues": "https://github.com/YOUR_USERNAME/supabasephp/issues",
        "source": "https://github.com/YOUR_USERNAME/supabasephp"
    },

    "require": {
        "php": "^8.4",
        "supabasephp/core": "*",
        "supabasephp/http": "*",
        "supabasephp/auth": "*",
        "supabasephp/database": "*",
        "supabasephp/storage": "*",
        "supabasephp/realtime": "*",
        "supabasephp/functions": "*",
        "supabasephp/vector": "*"
    },

    "autoload": {
        "psr-4": {
            "Supabase\\": "src/"
        }
    },

    "autoload-dev": {
        "psr-4": {
            "Supabase\\Client\\Tests\\": "tests/"
        }
    },

    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.1",
        "laravel/pint": "^1.0"
    },

    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "format": "pint",
        "format:test": "pint --test"
    },

    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.4.0"
        },
        "allow-plugins": {}
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
