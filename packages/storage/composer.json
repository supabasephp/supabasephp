{
    "name": "supabasephp/storage",
    "description": "Supabase Storage client for uploading, downloading and managing files.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "supabase",
        "php",
        "storage",
        "file-upload",
        "file-download",
        "buckets"
    ],
    "require": {
        "php": "^8.4",
        "supabasephp/core": "^1.0",
        "supabasephp/http": "^1.0",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "Supabase\\Storage\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
