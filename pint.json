{
    "preset": "psr12",
    "rules": {
        "array_syntax": {
            "syntax": "short"
        },
        "declare_strict_types": true,
        "fully_qualified_strict_types": true,
        "ordered_imports": {
            "sort_algorithm": "alpha"
        },
        "no_unused_imports": true,
        "single_line_empty_body": true,
        "single_quote": true,
        "strict_comparison": true,
        "strict_param": true,
        "trailing_comma_in_multiline": {
            "elements": [
                "arrays",
                "arguments",
                "parameters"
            ]
        }
    },
    "exclude": [
        "vendor",
        "build"
    ]
}
